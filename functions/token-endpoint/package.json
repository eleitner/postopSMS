{
  "name": "dnc-token-endpoint",
  "version": "0.1.0",
  "private": true,
  "description": "DNC platform: mints Retell register-phone-call sessions for the MA softphone. v0 prototype.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "gcp-build": "tsc",
    "start": "functions-framework --target=createSession --source=dist/index.js --port=8080",
    "dev": "tsx --watch src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.3.4",
    "@google-cloud/functions-framework": "^3.4.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
