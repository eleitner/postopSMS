# ═══════════════════════════════════════════════════
# PostOp SMS Protocol — Environment Configuration
# ═══════════════════════════════════════════════════

# Server
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.com

# PostgreSQL (use SSL in production)
DATABASE_URL=postgresql://postop:CHANGE_ME@localhost:5432/postop_sms
DB_SSL=true

# Twilio (HIPAA-eligible account required — sign BAA first)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_STATUS_CALLBACK_URL=https://your-domain.com/api/sms/status

# Triage nurse alert destination
TRIAGE_NURSE_PHONE=+1XXXXXXXXXX
TRIAGE_NURSE_EMAIL=triage@tidalhealth.org

# Authorized clinician phones — can use SMS switchboard commands (CALL, TEXT, STATUS, LIST)
# Comma-separated. Triage nurse phone is always authorized automatically.
AUTHORIZED_CLINICIAN_PHONES=+1XXXXXXXXXX,+1XXXXXXXXXX

# Anthropic (for AI triage summaries)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# HIPAA audit log
AUDIT_LOG_PATH=./logs/audit.log

# Facility
FACILITY_NAME=TidalHealth Peninsula Regional

# Demo mode (set to false for production)
DEMO_MODE=false
